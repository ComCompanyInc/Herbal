{# header/contacts.html.twig #}
<div class="user-info">
    <h3>Контактная информация</h3>
    <p><strong>Фамилия:</strong> {{ curUser.surname }}</p>
    <p><strong>Имя:</strong> {{ curUser.name }}</p>
    <p><strong>Отчество:</strong> {{ curUser.patronumic }}</p>
    <p><strong>Email:</strong> {{ curUser.access.email }}</p>
    <p><strong>Дата рождения:</strong> {{ curUser.dateOfBirth | date('d.m.Y') }}</p>
    <p><strong>Дата регистрации:</strong> {{ curUser.dateOfRegistration | date('d.m.Y') }}</p>
    <p><strong>Город:</strong> {{ curUser.country.name }}</p>
    <p><strong>Роль:</strong> {{ userRole }}</p>
    
    {% if (isSubscribed != false) and (isSubscribed != null) %}
        <button type="submit" id="{{ curUser.id }}" class="btn-unsubscribe unsubscribe">Отписаться</button>
    {% elseif (isSubscribed == false) %}
        <button type="submit" id="{{ curUser.id }}" class="btn-subscribe subscribe">Подписаться</button>
    {% endif %}
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const subscribeButton = document.querySelector(".subscribe"); // Первая кнопка "Подписаться"
        const unsubscribeButton = document.querySelector(".unsubscribe"); // Первая кнопка "Отписаться"

        // Обработка кнопки "Подписаться"
        if (subscribeButton) {
            subscribeButton.addEventListener("click", function(event) {
                event.preventDefault(); // Отменяем стандартное поведение кнопки
                const userId = this.id; // Получаем ID пользователя
                startAjax(userId, '/write_subscribe/');
            });
        }

        // Обработка кнопки "Отписаться"
        if (unsubscribeButton) {
            unsubscribeButton.addEventListener("click", function(event) {
                event.preventDefault(); // Отменяем стандартное поведение кнопки
                const userId = this.id; // Получаем ID пользователя
                startAjax(userId, '/remove_subscribe/');
            });
        }

        function startAjax(id, patch) {
            $.ajax({
                url: patch + id,
                type: 'GET',
                success: function(response) {
                    console.log("Успешно:", response);
                    location.reload(); // Перезагружаем страницу
                },
                error: function() {
                    alert("Ошибка при выполнении запроса");
                }
            });
        }
    });
</script>

<style>
    .user-info {
        background-color: #fff;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        padding: 20px;
        width: 300px;
        position: sticky; /* Блок будет "прилипать" при прокрутке */
        top: 20px; /* Отступ сверху, чтобы не прилипал вплотную к краю */
        align-self: flex-start; /* Выравниваем по верхнему краю */
        margin: 0 20px; /* Отступы слева и справа */
    }

    .user-info h3 {
        color: #28a745;
        margin-bottom: 15px;
    }

    .user-info p {
        margin: 5px 0;
    }

    .user-info strong {
        color: #333;
    }
</style>