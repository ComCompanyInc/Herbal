{% extends 'base.html.twig' %}

{% block body %}
    {% include 'header/header.html.twig' %}

    <head>
        <meta charset="UTF-8">
        <title>Welcome!</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    </head>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Comic+Sans+MS&display=swap');

        body {
            font-family: 'Comic Sans MS', cursive;
            background-color: #f8f9fa;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            overflow-y: auto; /* Добавлено для прокрутки */
        }

        .background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: linear-gradient(45deg, rgba(40, 167, 69, 0.1) 25%, transparent 25%),
            linear-gradient(-45deg, rgba(40, 167, 69, 0.1) 25%, transparent 25%),
            linear-gradient(45deg, transparent 75%, rgba(40, 167, 69, 0.1) 75%),
            linear-gradient(-45deg, transparent 75%, rgba(40, 167, 69, 0.1) 75%);
            background-size: 20px 20px;
            background-position: 0 0, 10px 10px, 10px 10px, 20px 20px;
            z-index: -1;
        }

        @keyframes fadeIn {
            0% {
                opacity: 0;
                transform: translateY(-20px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        h1, h2 {
            text-align: center;
            color: #28a745;
            margin-bottom: 30px;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
            opacity: 0;
            animation: slideIn 2s ease-in-out forwards;
        }

        @keyframes slideIn {
            0% {
                opacity: 0;
                transform: translateY(20px);
            }
            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .table {
            width: 100%;
            max-width: 900px; /* Добавлено ограничение по ширине */
            margin-bottom: 1rem;
            color: #212529;
            background-color: #fff;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            opacity: 0;
            animation: fadeIn 2s ease-in-out 1s forwards;
        }

        .table th, .table td {
            padding: 15px;
            vertical-align: top;
            border-top: 1px solid #dee2e6;
            word-wrap: break-word; /* Добавлено для переноса длинных слов */
            white-space: normal; /* Добавлено для переноса текста */
        }

        .table thead th {
            vertical-align: bottom;
            border-bottom: 2px solid #dee2e6;
            background-color: #28a745;
            color: white; /* Изменено для контраста */
        }

        .btn-remove, .remove-news {
            background-color: #dc3545;
            border: none;
            color: white;
            padding: 5px 10px;
            text-align: center;
            text-decoration: none;
            display: inline-block;
            font-size: 14px;
            cursor: pointer;
            border-radius: 5px;
        }

        .btn-remove:hover {
            background-color: #c82333;
        }

        .form-control {
            border: 2px solid green;
            border-radius: 10px;
            padding: 10px;
            margin-bottom: 10px;
        }

        .btn-primary {
            background: #28a745;
            border: none;
            border-radius: 10px;
            padding: 10px 20px;
            font-size: 16px;
            font-weight: bold;
        }

        .btn-primary:hover {
            background: #218838;
        }

        .content-wrapper {
            display: flex;
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
        }

        .sidebar {
            width: 300px;
            margin-right: 20px;
        }

        .main-content {
            flex-grow: 1;
        }

        /* Новые стили для кнопок */
        .btn-redact {
            background-color: #28a745; /* Зеленый цвет */
            border: none;
            color: white;
            padding: 5px 10px; /* Уменьшено до размера кнопки "Снять с публикации" */
            text-align: center;
            text-decoration: none;
            display: inline-block;
            font-size: 14px; /* Уменьшено до размера кнопки "Снять с публикации" */
            cursor: pointer;
            border-radius: 5px;
            margin-right: 10px;
        }

        .btn-redact:hover {
            background-color: #218838; /* Темно-зеленый цвет при наведении */
        }

        .btn-publishing {
            background-color: #007bff; /* Синий цвет */
            border: none;
            color: white;
            padding: 5px 10px; /* Уменьшено до размера кнопки "Снять с публикации" */
            text-align: center;
            text-decoration: none;
            display: inline-block;
            font-size: 14px; /* Уменьшено до размера кнопки "Снять с публикации" */
            cursor: pointer;
            border-radius: 5px;
        }

        .btn-publishing:hover {
            background-color: #0056b3; /* Темно-синий цвет при наведении */
        }
    </style>

    <div class="background"></div>

    <div class="content-wrapper">
        <!-- Контактная информация слева -->
        {% if (not(userRole is empty)) %}
            <div class="sidebar">
                {% include 'header/contacts.html.twig' %}
            </div>
        {% endif %}

        <!-- Основной контент -->
        <div class="main-content">
            <h1>Новость:</h1>

            <table class="table">
                <thead>
                <tr>
                    <th><h2 style="color: white;">{{ newData.title }}</h2></th>
                </tr>
                </thead>
                <tbody>
                <tr>
                    <th>
                        <p>
                            {{ newData.content.mainText }}
                        </p>
                    </th>
                </tr>
                <tr>
                    <th>{{ newData.content.dateSending | date }}</th>
                </tr>
                <tr>
                    <th>{{ newData.content.author.access.email }}</th>
                </tr>
                <tr>
                    {% if (not(user is empty)) and (user.email == newData.content.author.access.email) and (userRole == ACCESS_TYPES.0) %}
                        <th>
                            <button data-text="news" class="btn-remove remove" id="{{ newData.content.id }}">Снять с публикации</button>
                            <button data-text="news" class="btn-redact redact" id="{{ newData.content.id }}">Редактировать новость</button>
                        </th>
                    {% elseif (not(user is empty)) and (userRole == ACCESS_TYPES.1) %}
                        <th>
                            <button data-text="news" class="btn-remove remove" id="{{ newData.content.id }}">Снять с публикации</button>
                            <button data-text="news" class="btn-redact redact" id="{{ newData.content.id }}">Редактировать новость</button>
                            <button data-text="news" class="btn-publishing publishing" id="{{ newData.content.id }}">Опубликовать новость</button>

                            {% if newData.content.isDelete == true %}
                                Статус: НЕ ОПУБЛИКОВАННО
                            {% else %}
                                Статус: ОПУБЛИКОВАННО
                            {% endif %}
                        </th>
                    {% endif %}
                </tr>
                </tbody>
            </table>

            <h1>Комментарии:</h1>
            <h2>Написать комментарий:</h2>

            {% if isAuthored == true %}
                {{ form(commentForm) }}
            {% else %}
                <h3> <i>чтобы добавить комментарий необходимо авторизоваться</i> </h3>
            {% endif %}

            {% if not(comments is empty) %}
                <table class="table">
                    <thead>
                    <tr>
                        <th>Комментарий</th>
                        <th>Автор</th>
                        <th>Дата</th>
                        <th>Действия</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for comment in comments %}
                        <tr id="row-{{ comment.content.id }}">
                            <th>{{ comment.content.mainText }}</th>
                            <th>{{ comment.content.author.access.email }}</th>
                            <th>{{ comment.content.dateSending | date }}</th>
                            {% if (not(user is empty)) and (user.email == comment.content.author.access.email) and (userRole == ACCESS_TYPES.0) %}
                                <th><button class="btn-remove remove" id="{{ comment.content.id }}">Удалить</button></th>
                            {% elseif (not(user is empty)) and (userRole == ACCESS_TYPES.1) %}
                                <th><button class="btn-remove remove" id="{{ comment.content.id }}">Удалить</button></th>
                            {% endif %}
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <h4>Комментариев пока нет.</h4>
            {% endif %}
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js" integrity="sha384-IQsoLXl5PILFhosVNubq5LC7Qb9DXgDA9i+tQ8Zj3iwWAwPtgFTxbJ8NT4GN1R8p" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.min.js" integrity="sha384-cVKIPhGWiC2Al4u+LWgxfKTRIcfu0JTxR+EQDz/bgldoEyl4H0zUF0QKbrJ0EcQF" crossorigin="anonymous"></script>

    {% block javascripts %}
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const buttons = document.querySelectorAll(".remove");
                const buttonsRedact = document.querySelectorAll(".redact");
                const buttonsPublishing = document.querySelectorAll(".publishing");

                for (let i = 0; i < buttonsPublishing.length; i++) {
                    const button = buttonsPublishing[i];

                    button.addEventListener("click", function() {
                        window.location.href = '/publishing/' + button.id;
                    });
                }

                for (let i = 0; i < buttonsRedact.length; i++) {
                    const button = buttonsRedact[i];

                    button.addEventListener("click", function() {
                        window.location.href = '/addNews/' + button.id;
                    });
                }

                for (let i = 0; i < buttons.length; i++) {
                    const button = buttons[i];

                    button.addEventListener("click", function() {
                        startAjax(button.id);

                        // Проверяем, существует ли элемент и есть ли у него атрибут data-text
                        if (button && button.hasAttribute('data-text')) {
                            // Получаем значение атрибута data-text
                            let dataText = button.getAttribute('data-text');

                            // Проверяем, равно ли значение 'news'
                            if (dataText === 'news') {
                                // Перебрасываем пользователя на другую страницу
                                window.location.href = '/news';
                            }
                        }
                    });
                }

                function startAjax(id) {
                    $.ajax({
                        url: '/comments/remove/' + id,
                        type: 'GET',
                        success: function (response) {
                            $("#row-" + id).remove();
                        },
                        error: function () {
                            alert("error");
                        }
                    });
                }
            });
        </script>
    {% endblock %}

{% endblock %}